# RealitySync — Environment Variables
# Copy to .env and fill in values.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realitysync
DB_USER=realitysync
DB_PASSWORD=realitysync

# GCP (optional — only needed for GCS/PubSub features)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# STAC
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Edge Engine
EDGE_CONFIDENCE_THRESHOLD=0.70
EDGE_KMEANS_CLUSTERS=3
EDGE_SNAKE_MAX_ITERATIONS=100

# App
APP_SECRET_KEY=change-me-in-production
APP_ENV=development
